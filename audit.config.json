{
  "model": "claude-opus-5-5",
  "effort": "high",
  "budgetUsd": 10,
  "maxSourceFiles": 2000,
  "fullReadMaxFiles": 400,
  "fullReadMaxLines": 40000,
  "scannerTimeoutMinutes": 10,
  "sandbox": {
    "enabled": true,
    "images": { "node": "node:22-bookworm-slim", "python": "python:3.12-slim-bookworm" },
    "installNetwork": true,
    "installTimeoutMinutes": 10,
    "testTimeoutMinutes": 10,
    "memory": "2g",
    "cpus": 2,
    "pidsLimit": 512
  },
  "excludeDirs": [
    ".git",
    "node_modules",
    ".venv",
    "venv",
    "env",
    "__pycache__",
    "dist",
    "build",
    ".next",
    ".nuxt",
    ".svelte-kit",
    ".vercel",
    "coverage",
    ".pytest_cache",
    ".mypy_cache",
    ".audit"
  ],
  "sourceExtensions": [
    ".js", ".mjs", ".cjs", ".jsx", ".ts", ".tsx", ".vue", ".svelte",
    ".py", ".ipynb", ".rb", ".go", ".rs", ".java", ".kt", ".cs", ".php", ".swift",
    ".sql", ".sh", ".ps1", ".html", ".css", ".yml", ".yaml", ".toml", ".json"
  ]
}
